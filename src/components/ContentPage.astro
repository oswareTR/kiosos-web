---
import { localePath } from '../i18n/locales';
import { routePaths } from '../i18n/messages';
import { slogan, type RichPageCopy } from '../i18n/pageCopy';
import type { Locale } from '../i18n/locales';

type Props = {
  copy: RichPageCopy;
  locale: Locale;
  pageUrl: string;
};

const { copy, locale, pageUrl } = Astro.props;
const line = slogan[locale];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.heading,
  description: copy.description,
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Kiosos',
    url: 'https://kiosos.com',
  },
};
---

<article class="story" itemscope itemtype="https://schema.org/WebPage">
  <meta itemprop="name" content={copy.heading} />
  <meta itemprop="description" content={copy.description} />

  <header class="stage">
    <img class="mark" src="/kio_face.svg" alt="" width="120" height="110" decoding="async" />
    <p class="slogan">{line}</p>
    <h1>{copy.heading}</h1>
    <p class="display">{copy.tagline}</p>
    {
      copy.contactEmail && (
        <a class="mail" href={`mailto:${copy.contactEmail}`}>
          {copy.contactEmail}
        </a>
      )
    }
  </header>

  {
    copy.sections.map((section, index) => (
      <section
        class:list={['band', { 'band--tint': index % 2 === 1 }]}
        id={section.id}
        aria-labelledby={`${section.id}-heading`}
      >
        <div class="band__inner">
          <p class="kicker">{section.kicker}</p>
          <h2 id={`${section.id}-heading`}>{section.statement}</h2>
          {section.body && <p class="body">{section.body}</p>}
          {section.points && section.points.length > 0 && (
            <ul class="points">
              {section.points.map((point) => (
                <li>
                  <p class="points__title">{point.title}</p>
                  <p class="points__text">{point.text}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))
  }

  {
    copy.ctas && copy.ctas.length > 0 && (
      <footer class="close">
        <p class="slogan">{line}</p>
        <nav aria-label={locale === 'tr' ? 'İlgili sayfalar' : 'Related pages'}>
          {copy.ctas.map((cta) => (
            <a href={localePath(routePaths[cta.route], locale)}>{cta.label}</a>
          ))}
        </nav>
      </footer>
    )
  }
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .story {
    padding-bottom: 6.5rem;
  }

  .stage,
  .band__inner,
  .close {
    width: min(68rem, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: min(78vh, 44rem);
    justify-content: center;
    padding: 2.5rem 0 4.5rem;
    gap: 0.85rem;
  }

  .mark {
    width: 4.25rem;
    height: auto;
    margin-bottom: 0.75rem;
  }

  :global([data-theme='dark']) .mark {
    filter: invert(1);
  }

  .slogan {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
  }

  h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .display {
    margin: 0.35rem 0 0;
    max-width: 16ch;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--color-muted);
  }

  .mail {
    margin-top: 1.25rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.15rem;
  }

  .mail:hover {
    border-bottom-color: var(--color-text);
  }

  .band {
    padding: 5.5rem 0;
  }

  .band--tint {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .band__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .body {
    margin: 0.35rem 0 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .points {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .points li {
    padding: 1.35rem 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .band--tint .points li {
    background: var(--color-bg);
  }

  .points__title {
    margin: 0 0 0.45rem;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .points__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .close {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.35rem;
    padding: 5rem 0 1rem;
  }

  .close nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .close a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.15rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .close a:hover {
    background: var(--color-hover);
  }

  @media (min-width: 800px) {
    .band__inner {
      padding-inline: 1rem;
    }
  }
</style>
