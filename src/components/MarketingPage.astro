---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from './ContentPage.astro';
import { getRichPageCopy } from '../i18n/pageCopy';
import type { RouteId } from '../i18n/messages';
import { canonicalUrl, resolveLocale } from '../lib/site';

type Props = {
  route: Exclude<RouteId, 'home'>;
};

const { route } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const copy = getRichPageCopy(locale, route);
const pageUrl = canonicalUrl(Astro.url.pathname);
---

<BaseLayout route={route} title={copy.title} description={copy.description}>
  <ContentPage copy={copy} locale={locale} pageUrl={pageUrl} />
</BaseLayout>
