---
type Props = {
  heading: string;
  lead?: string;
};

const { heading, lead = 'İçerik yakında.' } = Astro.props;
---

<section class="placeholder">
  <h1>{heading}</h1>
  <p>{lead}</p>
</section>

<style>
  .placeholder {
    max-width: 36rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 6rem;
    text-align: center;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
