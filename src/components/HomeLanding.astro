---
import { localePath } from '../i18n/locales';
import { routePaths } from '../i18n/messages';
import { getHomeCopy, slogan } from '../i18n/pageCopy';
import type { Locale } from '../i18n/locales';

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
const line = slogan[locale];

const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kiosos',
  url: 'https://kiosos.com',
  description: line,
  inLanguage: locale === 'tr' ? 'tr' : 'en',
};
---

<div class="home">
  <header class="stage">
    <img
      class="mark"
      src="/kio_face.svg"
      alt=""
      width="220"
      height="200"
      decoding="async"
      fetchpriority="high"
    />
    <h1>
      <span class="brand">{copy.brand}</span>
      <span class="line">{copy.headline}</span>
    </h1>
    <p class="lede">{copy.intro}</p>
  </header>

  <section class="products" aria-labelledby="products-label">
    <h2 id="products-label" class="products__label">{copy.exploreLabel}</h2>
    <ol>
      {
        copy.cards.map((card, index) => (
          <li>
            <a href={localePath(routePaths[card.route], locale)}>
              <span class="index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="copy">
                <span class="kicker">{card.kicker}</span>
                <span class="title">{card.title}</span>
                <span class="blurb">{card.blurb}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <footer class="close">
    <p class="slogan">{line}</p>
    <a class="mission" href={localePath(routePaths.mission, locale)}>{copy.missionLinkLabel}</a>
  </footer>
</div>

<script type="application/ld+json" set:html={JSON.stringify(homeLd)} />

<style>
  .home {
    padding-bottom: 6.5rem;
  }

  .stage,
  .products,
  .close {
    width: min(68rem, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: min(82vh, 46rem);
    justify-content: center;
    padding: 1.5rem 0 3rem;
  }

  .mark {
    width: min(7.5rem, 32vw);
    height: auto;
    margin-bottom: 1.75rem;
  }

  :global([data-theme='dark']) .mark {
    filter: invert(1);
  }

  h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .brand {
    font-size: clamp(3.25rem, 10vw, 6.5rem);
  }

  .line {
    font-size: clamp(1.65rem, 4.2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--color-muted);
  }

  .lede {
    margin: 1.5rem 0 0;
    max-width: 22rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .products {
    padding: 1rem 0 2rem;
  }

  .products__label {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.75rem;
    align-items: baseline;
    padding: 2.25rem 0;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--color-border);
  }

  li:last-child a {
    border-bottom: 1px solid var(--color-border);
  }

  li a:hover .title {
    letter-spacing: -0.035em;
  }

  .index {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .kicker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .title {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    transition: letter-spacing 0.25s ease;
  }

  .blurb {
    max-width: 28rem;
    margin-top: 0.35rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .close {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 4.5rem 0 1rem;
  }

  .slogan {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mission {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.1rem;
  }

  .mission:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }
</style>
